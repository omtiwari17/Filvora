# Django Core Configuration
DJANGO_SECRET_KEY=django-insecure-change-this-to-a-secure-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# TMDB (The Movie Database) API
# Register and grab your free v3 API Key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

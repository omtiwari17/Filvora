# Filvora Production Caddy Reverse Proxy Configuration
# Automatic HTTPS, HTTP/2, HTTP/3, and Gzip compression

{$FILVORA_DOMAIN:localhost} {
    # Gzip & Zstandard compression
    encode gzip zstd

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Static Assets Fast Caching
    handle /static/* {
        root * /app
        file_server
    }

    # Reverse proxy to Django application
    handle {
        reverse_proxy web:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Forwarded-Host {host}
            header_up X-Real-IP {remote_host}
        }
    }
}
